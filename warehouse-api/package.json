{
  "name": "power-house-warehouse-api",
  "version": "0.1.0",
  "private": true,
  "description": "Power House warehouse REST API (Node.js + Express + Prisma + PostgreSQL)",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "db:check": "node scripts/db-check.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:verify": "node scripts/db-verify.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "connect-pg-simple": "10.0.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "main": "src/server.js"
}
