# Copy this file to .env and fill it in. NEVER commit .env (it is in .gitignore).
# Get the two Neon addresses from Neon > your project > Connect (ask the leader; share them privately, never on GitHub or in the group chat).

# Online (Neon, Plan A)
# DATABASE_URL = the POOLED address (host has "-pooler"), used by the running API
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.ap-southeast-1.aws.neon.tech/powerhouse?sslmode=require"
# DIRECT_URL = the DIRECT address (no "-pooler"), used by Prisma to create/change tables
DIRECT_URL="postgresql://USER:PASSWORD@HOST.ap-southeast-1.aws.neon.tech/powerhouse?sslmode=require"

# Offline (local PostgreSQL 18, Plan B): replace both lines above with
# DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/powerhouse"
# DIRECT_URL="postgresql://postgres:PASSWORD@localhost:5432/powerhouse"

# Secret used to sign login cookies: any long random text
SESSION_SECRET="change-me-to-a-long-random-string"

# Port the API runs on
PORT=4000

# Let the website's "Reset demo data" button reload the sample data. Demo only: never "true" on a real store
ALLOW_DEMO_RESET=true

# Website addresses allowed to call the API with a login cookie (comma-separated)
CORS_ORIGINS="http://localhost:5500,http://127.0.0.1:5500"
